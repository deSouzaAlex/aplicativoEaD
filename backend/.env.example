# Copie este arquivo para .env e ajuste os valores.
NODE_ENV=development
PORT=3001
API_URL=/api/v1
# Local: mongodb://127.0.0.1:27017/academico-app
# Nuvem (ex.: MongoDB Atlas): mongodb+srv://usuario:senha@cluster.xxxxx.mongodb.net/academico-app
MONGODB_URI=mongodb://127.0.0.1:27017/academico-app
# Gere um valor longo e aleatório em produção: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=7d
# Origens autorizadas a chamar a API, separadas por vírgula (vazio = todas, só em desenvolvimento)
CORS_ORIGIN=http://localhost:5173
